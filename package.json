{
  "name": "ledgerline",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @ledgerline/api dev",
    "dev:ui": "pnpm --filter @ledgerline/ui dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "catalog:",
    "husky": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "argon2", "esbuild", "prisma"]
  }
}
